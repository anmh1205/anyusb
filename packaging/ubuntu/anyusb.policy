<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AnyUSB</vendor>
  <action id="io.anyusb.open-dashboard">
    <description>Open the local AnyUSB dashboard</description>
    <message>Open AnyUSB from the active local desktop session</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/anyusb/open-dashboard</annotate>
  </action>
</policyconfig>
